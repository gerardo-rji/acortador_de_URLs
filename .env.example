NODE_ENV=development
PORT=3000
DB_NAME=snap.db
# Obligatorio en producción (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Obligatorio en producción (mínimo 32 caracteres; distinto de JWT_SECRET).
# Seudonimiza a los visitantes en las analíticas: si se cambia, los visitantes
# únicos se vuelven a contar desde cero.
VISITOR_HASH_SECRET=

# Coste de bcrypt (4-15, por defecto 12)
BCRYPT_ROUNDS=12
